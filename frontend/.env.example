# ─────────────────────────────────────────
# Frontend Environment Example
# Copy to .env and adjust.
# ─────────────────────────────────────────

# API base URL (backend)
# Use the relative path so requests flow through Vite's dev proxy to the
# backend, avoiding CORS issues with multipart uploads.
VITE_API_URL=/api

# Embedding model (Transformers.js / sentence-transformers)
VITE_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Key derivation parameters (must match what the client uses)
VITE_PBKDF2_ITERATIONS=600000
