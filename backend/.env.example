# ─────────────────────────────────────────
# Backend Environment Example
# Copy to .env and adjust for your setup.
# ─────────────────────────────────────────

# Server
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Database
# Local:       postgresql://zk_user:password@localhost:5432/zk_storage
# Neon (prod): postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://zk_user:change_me_in_production@localhost:5432/zk_storage

# JWT — generate strong random secrets for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-access-token-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Storage
STORAGE_DRIVER=local
STORAGE_PATH=./uploads
# S3 (if STORAGE_DRIVER=s3) — selected free provider: Supabase Storage (no card needed)
#   S3_ENDPOINT = https://<project-ref>.supabase.co/storage/v1/s3
#   S3_BUCKET   = <bucket-name>   |   S3_REGION = us-east-1
#   Keys: Supabase Dashboard → Project Settings → Storage → S3 access keys
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
